# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"

# JWT secret for session tokens (use a long random string)
JWT_SECRET="change-me-to-a-long-random-string"

# Email validation on signup:
# - DISPOSABLE_EMAIL_DOMAINS: extra disposable domains to block (comma-separated, optional).
# - SKIP_EMAIL_MX_CHECK: set to "true" to disable DNS MX deliverability checks (e.g. local testing).
DISPOSABLE_EMAIL_DOMAINS=""
SKIP_EMAIL_MX_CHECK="false"

# SMTP settings for transactional email (password reset codes).
# Leave SMTP_HOST unset to log reset codes to the server console (dev only).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Godgifted <info@godgifted.com>"
